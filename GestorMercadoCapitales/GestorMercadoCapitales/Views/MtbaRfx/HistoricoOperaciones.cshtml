@model List<OrderAll>

<H1>Histórico de operaciones</H1>


@if(Model.Count == 0)
{

    <div class="alert alert-info">
        <strong>Importante!</strong> No cuenta con operaciones hasta el momento... Favor varefiquelo de vuelta
    </div>
}
else
{
    <table class="table table-striped table-dark">
        <thead class="">
            <tr>
                <th scope="col">Orden</th>
                <th scope="col">Instrumento</th>
                <th scope="col">Precio</th>
                <th scope="col">Cantidad</th>
                <th scope="col">Estado</th>
                <th scope="col">Tipo</th>
            </tr>
        </thead>
        <tbody>

            @try
            {
                @foreach (var datos in Model)
                {
            <tr>
                <td>@datos.ClientOrderId</td>
                <td>@datos.InstrumentId.Symbol</td>
                <td>@datos.Price</td>
                <td>@datos.Quantity</td>
                <td>
                    @foreach (var datosStatus in datos.StatusHistory)
                    {
                        @if (datosStatus.StatusText == "ME_ACCEPTED")
                        {
                            <text><h4><span class="badge badge-info">Pendiente</span></h4></text>
                        }
                        else
                        @if (datosStatus.StatusText.Trim().ToUpper() == "ENVIADA")
                        {
                            <text><h4><span class="badge badge-warning">ENVIADA</span></h4></text>
                        }
                        else
                        @if (datosStatus.StatusText.Trim().ToUpper() == "OPERADA")
                        {
                            <text><h4><span class="badge badge-success">Operada</span></h4></text>
                        }
                        else
                        @if (datosStatus.StatusText.Trim().ToUpper() == "ACEPTADA")
                        {
                            <text><h4><span class="badge badge-primary">ACEPTADA</span></h4></text>
                        }
                        else
                        @if (datosStatus.StatusText.Trim().ToUpper() != "OPERADA" && datosStatus.StatusText != "ME_ACCEPTED")
                        {
                            <text><h4><span class="badge badge-danger">Error - @datosStatus.StatusText</span></h4></text>
                        }

                    }
                </td>
                <td>Compra</td>
            </tr>
                }
            }
            catch { }


        </tbody>
    </table>
    

}




