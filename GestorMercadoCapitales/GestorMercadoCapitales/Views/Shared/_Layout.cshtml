    <script>
        $(document).ready(function () {
            $("#btnLoadPartial").click(function (e) {
                e.preventDefault(); // Previene la navegación predeterminada

                // Llamada AJAX para obtener el partial view
                $.get("/MtbaRfx/Futuros_Financieros", function (data) {
                    // Inserta el contenido en el contenedor
                    $("#partialContainer").html(data);

                }).fail(function () {
                    alert("Error loading content. Please try again.");
                });
            });
        });
    </script>

    <script>

        //(function loop() {
        //    setTimeout(function () {
        //        $('#partialContainer #TablaPrincipal').load(location.href + "#partialContainer #TablaPrincipal");
        //        loop();
        //    }, 5000);
        //})();

        (function loop() {
            setTimeout(function () {
                $.get('/MtbaRfx/Futuros_Financieros', function (data) {
                    // Reemplaza solo el contenido necesario
                    $('#TablaPrincipal').replaceWith($(data).find('#TablaPrincipal'));
                }).fail(function () {
                    console.error("Error al cargar el contenido desde el controlador.");
                });
                loop();
            }, 10000);
        })();


        $('#partialContainer #TablaPrincipal').click(function () {

            $('#example tbody').on('click', 'tr', function () {

                // Remover clase de TR seleccionada, si es que hay
                $('tr.selected').removeClass('selected');
                // Asignar clase seleccionada a TR actual
                $(this).addClass('selected');
                // Obtener TD's
                var tds = $(this).children();

                //alert($(tds[0]).text())
                $("#symbol").select2("val", [$(tds[0]).text()]);
                document.getElementById("precio").value = $(tds[2]).text();
                document.getElementById("cantidad").value = $(tds[4]).text();


            });

        });

    </script>


